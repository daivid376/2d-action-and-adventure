[sub_resource type="GDScript" id="GDScript_bhhdu"]
script/source = "class_name Player extends CharacterBody2D

const MOVE_SPEED :float = 200.0
var direction : Vector2 = Vector2.ZERO

enum FacingDirection {UP,DOWN,RIGHT,LEFT}
var cardinal_direction: FacingDirection = FacingDirection.DOWN
#enum PlayerState {IDLE,WALK}
#var state : PlayerState = PlayerState.IDLE

@onready var animation_player: AnimationPlayer = $AnimationPlayer
@onready var sprite_2d: Sprite2D = $Sprite2D
@onready var state_machine: StateMachine = $StateMachine

func _ready():
	state_machine.init(self)
	pass
	
func _process(delta):
	#var stateChanged : bool = update_state()
	#var directionChanged : bool = update_direction()
	#if stateChanged || directionChanged:
		#
		#
	#
	pass
	
func _physics_process(delta: float) -> void:
	direction = Input.get_vector(\"move_left\",'move_right','move_up','move_down')
	
	move_and_slide()


func update_animation(current_state:String) -> void:
	var play_anim : String = current_state + '_' + get_animation_direction_name()
	if not animation_player.has_animation(play_anim):
		push_error('Animation not found: ' + play_anim)
		return 
	elif animation_player.current_animation != play_anim:
		animation_player.play(play_anim)
	

		
func get_animation_direction_name() -> String:
	
	var dir_name:String = FacingDirection.find_key(cardinal_direction).to_lower()
	dir_name = 'side' if dir_name in['left','right'] else dir_name
	return dir_name

#func get_state_name() -> String:
	#match state:
		#PlayerState.IDLE:
			#return 'idle'
		#PlayerState.WALK:
			#return 'walk'
		#_:
			#return 'idle'
#func update_state() -> bool:
	#var new_state = PlayerState.IDLE if direction == Vector2.ZERO else PlayerState.WALK
	#if new_state == state:
		#return false
	#else:
		#state = new_state
		#return true
func update_direction() -> bool:
	
	if direction == Vector2.ZERO:
		return false
		
	var new_cardinal_dir : FacingDirection = FacingDirection.DOWN
	if abs(direction.x) > abs(direction.y):
		new_cardinal_dir = FacingDirection.RIGHT if direction.x > 0.0 else FacingDirection.LEFT
	else:
		new_cardinal_dir = FacingDirection.DOWN if direction.y >0.0 else FacingDirection.UP
	
	if new_cardinal_dir == cardinal_direction:
		return false
	else:
		cardinal_direction = new_cardinal_dir
		var abs_scale_x = abs(sprite_2d.scale.x)
		sprite_2d.scale.x = -1 * abs_scale_x if cardinal_direction == FacingDirection.LEFT else abs_scale_x
		return true
	
	
	
	
	
"

